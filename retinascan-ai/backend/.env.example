# Copy this file to .env and fill in your real keys.
# NEVER commit .env or paste your real keys anywhere public (chat, GitHub, etc.)

GEMINI_API_KEY=your_gemini_api_key_here

# Supabase: Project Settings -> API -> Project URL and anon/public key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional overrides
MODEL_CHECKPOINT_PATH=checkpoints/dr_model.pth
ALLOWED_ORIGINS=*
